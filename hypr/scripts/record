#!/usr/bin/env bash

set -euo pipefail

RECORDING_DIR="$HOME/Videos/Recordings"
TIMESTAMP="$(date '+%Y-%m-%d_%H-%M-%S')"
OUTPUT="$RECORDING_DIR/${TIMESTAMP}.mkv"

mkdir -p "$RECORDING_DIR"

# If wf-recorder is already running, stop it.
if pgrep -x wf-recorder >/dev/null; then
    pkill -INT -x wf-recorder

    notify-send "Screen recording" "Recording stopped"
    exit 0
fi

# Start recording.
case "${1:-screen}" in
    screen)
        wf-recorder -a -f "$OUTPUT"
        ;;

    dp1)
        wf-recorder -a -o DP-1 -f "$OUTPUT"
        ;;

    dp2)
        wf-recorder -a -o DP-2 -f "$OUTPUT"
        ;;

    area)
        GEOMETRY="$(slurp)"

        if [[ -z "$GEOMETRY" ]]; then
            notify-send "Screen recording" "Recording cancelled"
            exit 0
        fi

        wf-recorder -a -g "$GEOMETRY" -f "$OUTPUT"
        ;;

    *)
        echo "Usage: $0 {screen|dp1|dp2|area}"
        exit 1
        ;;
esac

notify-send "Screen recording" "Recording saved to $OUTPUT"
